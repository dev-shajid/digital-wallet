<Project>
  <!--
    Central Package Management: every NuGet package version is pinned here ONCE.
    This is the .NET equivalent of a single package.json + lockfile shared by every
    workspace package in a pnpm/yarn monorepo - individual .csproj files reference a
    package by name only (no version number), so every project always agrees on the
    same version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Forces indirect/transitive packages (e.g. EF Core pulled in by the health-check
         package) to line up with the versions pinned below too, not just direct references. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core: the ORM (like Prisma/TypeORM/Sequelize in Node) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Maps C# PascalCase (User, CreatedAt) to Postgres snake_case (user, created_at) -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />

    <!-- Serilog: structured logging (like pino/winston in Node) -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Health checks: readiness probe that pings Postgres -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />

    <!-- Swagger/OpenAPI: like swagger-jsdoc + swagger-ui-express, generated from code -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <!-- Testing: xUnit is the Jest/Mocha equivalent -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
</Project>
